# Staging Environment Variables
# Скопируйте этот файл в .env.staging и заполните реальными значениями

# Application
NODE_ENV=staging
APP_URL=https://staging.yourapp.com
API_URL=https://staging-api.yourapp.com

# Database
DB_USER=saas_staging_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_NAME=saas_staging_db
DB_PORT=5432
DATABASE_URL=postgresql://saas_staging_user:CHANGE_THIS_SECURE_PASSWORD@postgres:5432/saas_staging_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Payment Providers - YooKassa
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key

# Payment Providers - CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=your_public_id
CLOUDPAYMENTS_API_SECRET=your_api_secret

# Payment Providers - Robokassa
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD_1=password1
ROBOKASSA_PASSWORD_2=password2
ROBOKASSA_TEST_MODE=true

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourapp.com

# Frontend
NEXT_PUBLIC_API_URL=https://staging-api.yourapp.com/api

# Ports (опционально, можно переопределить в docker-compose)
BACKEND_PORT=3000
FRONTEND_PORT=3001
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
